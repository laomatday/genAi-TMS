{
  "name": "genai",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:e2e": "vite --host 127.0.0.1 --port 3107 --strictPort",
    "audit:repo": "bun scripts/verify-production-readiness.mjs",
    "audit:dependencies": "bun audit --audit-level=high",
    "deadcode": "knip",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "bun scripts/load-test-dashboard.mjs",
    "reset:passwords": "bun scripts/reset-default-passwords.mjs",
    "provision:kiosks": "bun scripts/provision-kiosk-accounts.mjs",
    "check": "bun run audit:repo && bun run deadcode && bun run test && bun run build",
    "check:release": "bun run check && bun run audit:dependencies",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "barcode-detector": "^3.2.2",
    "framer-motion": "^11.11.17",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.3",
    "read-excel-file": "9.3.10",
    "recharts": "^3.10.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.35.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "knip": {
    "entry": [
      "public/sw.js",
      "supabase/functions/*/index.ts"
    ],
    "ignoreDependencies": [
      "jsr",
      "npm"
    ]
  }
}
